datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleType {
  PLATFORM_ADMIN
  CLASS_REPRESENTATIVE
  GROUP_LEADER
  STUDENT
}

enum GroupStatus {
  FORMING
  COMPLETE
  INCOMPLETE
  LOCKED
  ARCHIVED
}

enum IssueStatus {
  OPEN
  TRIAGED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model Institution {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms  AcademicTerm[]
  users  User[]
}

model AcademicTerm {
  id            String      @id @default(uuid())
  institutionId String
  name          String
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean     @default(false)
  createdAt     DateTime    @default(now())

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  offerings     CourseOffering[]
}

model ClassCohort {
  id        String   @id @default(uuid())
  name      String
  year      Int
  createdAt DateTime @default(now())

  offerings CourseOffering[]
  roles     UserRole[]
}

model CourseUnit {
  id            String   @id @default(uuid())
  code          String   @unique
  title         String
  lecturerName  String?
  lecturerEmail String?
  lecturerPhone String?
  createdAt     DateTime @default(now())

  offerings CourseOffering[]
}

model CourseOffering {
  id           String   @id @default(uuid())
  unitId       String
  termId       String
  classId      String
  minGroupSize Int      @default(5)
  maxGroupSize Int      @default(10)
  createdAt    DateTime @default(now())

  unit         CourseUnit   @relation(fields: [unitId], references: [id])
  term         AcademicTerm @relation(fields: [termId], references: [id])
  class        ClassCohort  @relation(fields: [classId], references: [id])

  enrollments  Enrollment[]
  groups       Group[]
  announcements Announcement[]
  assignments  Assignment[]
  events       TimetableEvent[]
  issues       Issue[]
}

model User {
  id                 String   @id @default(uuid())
  institutionId      String
  email              String   @unique
  passwordHash       String
  fullName           String
  studentNumber      String?  @unique
  registrationNumber String?  @unique
  isActive           Boolean  @default(true)
  isEmailVerified    Boolean  @default(false)
  verificationToken  String?
  tookGapYear        Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  institution        Institution @relation(fields: [institutionId], references: [id])
  roles              UserRole[]
  enrollments        Enrollment[]
  memberships        GroupMembership[]
  submissions        Submission[]
  issues             Issue[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  authoredAnnouncements Announcement[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  role      RoleType
  classId   String?
  createdAt DateTime @default(now())

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  class     ClassCohort? @relation(fields: [classId], references: [id])
}

model Enrollment {
  id         String   @id @default(uuid())
  studentId  String
  offeringId String
  createdAt  DateTime @default(now())

  student    User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([studentId, offeringId])
}

model Group {
  id          String      @id @default(uuid())
  offeringId  String
  name        String
  leaderId    String
  status      GroupStatus @default(FORMING)
  isOpen      Boolean     @default(true)
  isLocked    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  offering    CourseOffering    @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  memberships GroupMembership[]
  changeRequests GroupChangeRequest[]
}

model GroupMembership {
  id         String   @id @default(uuid())
  groupId    String
  studentId  String
  offeringId String
  joinedAt   DateTime @default(now())

  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, offeringId])
}

model GroupChangeRequest {
  id             String   @id @default(uuid())
  groupId        String
  studentId      String
  targetGroupId  String?
  reason         String
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())

  group          Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Announcement {
  id         String   @id @default(uuid())
  offeringId String
  authorId   String
  title      String
  content    String
  tag        String   @default("GENERAL")
  createdAt  DateTime @default(now())

  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  author     User           @relation(fields: [authorId], references: [id])
}

model Assignment {
  id         String   @id @default(uuid())
  offeringId String
  title      String
  description String  @default("No description provided.")
  dueDate    DateTime
  type       String  @default("HOMEWORK")
  createdAt  DateTime @default(now())

  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  submissions Submission[]
}

model Submission {
  id           String   @id @default(uuid())
  assignmentId String
  studentId    String
  fileUrl      String
  submittedAt  DateTime @default(now())

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Issue {
  id          String      @id @default(uuid())
  studentId   String
  offeringId  String
  category    String
  title       String
  description String
  status      IssueStatus @default(OPEN)
  createdAt   DateTime    @default(now())

  student     User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  offering    CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
}

model TimetableEvent {
  id         String   @id @default(uuid())
  offeringId String
  title      String
  dayOfWeek  Int
  startTime  String
  endTime    String
  location   String?

  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
}

model ImportJob {
  id        String   @id @default(uuid())
  filename  String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model ExportJob {
  id        String   @id @default(uuid())
  type      String
  status    String   @default("PENDING")
  downloadUrl String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
