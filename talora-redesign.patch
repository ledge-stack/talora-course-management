+/* --- Roll call / roster primitives (signature element) --- */
+
+.roster-dots {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.3rem;
+}
+
+.roster-dot {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--border-strong);
+  flex-shrink: 0;
+}
+
+.roster-dot.filled {
+  background: var(--color-primary);
+}
+
+.roster-dot.filled.complete {
+  background: var(--color-accent-teal);
+}
+
+.roster-slot {
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+  padding: 0.625rem 0.875rem;
+  border-radius: 8px;
+  font-size: 0.875rem;
+}
+
+.roster-slot.claimed {
+  background: var(--color-bg-surface-hover);
+  color: var(--color-text-primary);
+}
+
+.roster-slot.open {
+  border: 1.5px dashed var(--border-strong);
+  color: var(--color-text-muted);
+}
+
+.roster-slot-mark {
+  width: 20px;
+  height: 20px;
+  border-radius: 50%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+  font-size: 0.75rem;
+}
+
+.roster-slot.claimed .roster-slot-mark {
+  background: var(--color-primary-transparent);
+  color: var(--color-primary);
+}
+
+.roster-slot.claimed.leader .roster-slot-mark {
+  background: var(--color-accent-violet-bg);
+  color: var(--color-accent-violet);
+}
+
+.leader-tag {
+  font-family: var(--font-mono);
+  font-size: 0.625rem;
+  font-weight: 500;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: var(--color-accent-violet);
+  background: var(--color-accent-violet-bg);
+  padding: 0.15rem 0.45rem;
+  border-radius: 4px;
+}
+
+@keyframes claim-stamp {
+  0% { transform: scale(0.6); opacity: 0; }
+  55% { transform: scale(1.15); opacity: 1; }
+  100% { transform: scale(1); opacity: 1; }
+}
+
+.roster-slot.just-claimed .roster-slot-mark {
+  animation: claim-stamp 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both;
+}
+
+.reg-number {
+  font-family: var(--font-mono);
+  font-size: 0.8125rem;
+  color: var(--color-text-muted);
+  letter-spacing: 0.01em;
+}
+
+.highlight-row {
+  position: relative;
+}
+
+.highlight-row td:first-child {
+  box-shadow: inset 3px 0 0 var(--color-primary);
+}
+
 .sidebar-footer {
   padding: 1.5rem 1rem;
   border-top: 1px solid var(--border-subtle);
