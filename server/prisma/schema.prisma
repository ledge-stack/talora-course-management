generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  group_leader
  class_rep
}

enum ApplicationStatus {
  pending
  approved
  rejected
}

enum ComplaintStatus {
  open
  in_review
  resolved
}

model User {
  id                 String              @id @default(uuid())
  studentId          String              @unique @map("student_id")
  fullName           String              @map("full_name")
  email              String              @unique
  password           String
  role               UserRole            @default(student)
  isRetake           Boolean             @default(false) @map("is_retake")
  createdAt          DateTime            @default(now()) @map("created_at")
  memberships        GroupMembership[]
  groupsLed          Group[]             @relation("GroupLeader")
  defaultTemplate    DefaultGroupTemplate?
  applications       GroupApplication[]
  submissions        Submission[]
  complaints         Complaint[]

  @@map("users")
}

model CourseUnit {
  id                 String           @id @default(uuid())
  code               String           @unique
  title              String
  minGroupSize       Int              @default(1) @map("min_group_size")
  maxGroupSize       Int              @map("max_group_size")
  submissionDeadline DateTime?        @map("submission_deadline")
  allowsSwaps        Boolean          @default(true) @map("allows_swaps")
  groups             Group[]
  complaints         Complaint[]
  timetableSlots     TimetableSlot[]

  @@map("course_units")
}

model Group {
  id             String               @id @default(uuid())
  courseUnitId   String               @map("course_unit_id")
  courseUnit     CourseUnit           @relation(fields: [courseUnitId], references: [id], onDelete: Cascade)
  groupNumber    Int                  @map("group_number")
  leaderId       String?              @map("leader_id")
  leader         User?                @relation("GroupLeader", fields: [leaderId], references: [id])
  whatsappLink   String?              @map("whatsapp_link")
  memberships    GroupMembership[]
  applications   GroupApplication[]
  submissions    Submission[]
  complaints     Complaint[]

  @@unique([courseUnitId, groupNumber])
  @@map("groups")
}

model DefaultGroupTemplate {
  id           String                 @id @default(uuid())
  leaderId     String                 @unique @map("leader_id")
  leader       User                   @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  templateName String                 @default("My Default Team") @map("template_name")
  members      DefaultTemplateMember[]

  @@map("default_group_templates")
}

model DefaultTemplateMember {
  id         String                @id @default(uuid())
  templateId String                @map("template_id")
  template   DefaultGroupTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId     String                @map("user_id")

  @@unique([templateId, userId])
  @@map("default_template_members")
}

model GroupMembership {
  id       String   @id @default(uuid())
  groupId  String   @map("group_id")
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRetake Boolean  @default(false) @map("is_retake")
  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([groupId, userId])
  @@map("group_memberships")
}

model GroupApplication {
  id          String            @id @default(uuid())
  groupId     String            @map("group_id")
  group       Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  applicantId String            @map("applicant_id")
  applicant   User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(pending)
  appliedAt   DateTime          @default(now()) @map("applied_at")
  respondedAt DateTime?         @map("responded_at")

  @@unique([groupId, applicantId])
  @@map("group_applications")
}

model Submission {
  id             String   @id @default(uuid())
  groupId        String   @map("group_id")
  group          Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  submittedBy    String?  @map("submitted_by")
  user           User?    @relation(fields: [submittedBy], references: [id])
  fileUrl        String   @map("file_url")
  fileName       String   @map("file_name")
  fileSizeBytes  BigInt   @map("file_size_bytes")
  version        Int      @default(1)
  submittedAt    DateTime @default(now()) @map("submitted_at")

  @@map("submissions")
}

model Complaint {
  id             String          @id @default(uuid())
  submittedBy    String          @map("submitted_by")
  user           User            @relation(fields: [submittedBy], references: [id], onDelete: Cascade)
  courseUnitId   String?         @map("course_unit_id")
  courseUnit     CourseUnit?     @relation(fields: [courseUnitId], references: [id])
  groupId        String?         @map("group_id")
  group          Group?          @relation(fields: [groupId], references: [id])
  subject        String
  description    String
  status         ComplaintStatus @default(open)
  createdAt      DateTime        @default(now()) @map("created_at")

  @@map("complaints")
}

model TimetableSlot {
  id           String     @id @default(uuid())
  courseUnitId String     @map("course_unit_id")
  courseUnit   CourseUnit @relation(fields: [courseUnitId], references: [id], onDelete: Cascade)
  dayOfWeek    String     @map("day_of_week")
  startTime    String     @map("start_time")
  endTime      String     @map("end_time")
  venue        String
  lecturerName String     @map("lecturer_name")

  @@map("timetable")
}
